# App
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_ALLOW_CRAWL=false

# API
# Leave empty to use same-origin requests, or set your backend URL.
NEXT_PUBLIC_API_BASE_URL=

# Auth
# Replace with a strong random value before deploying.
NEXT_PUBLIC_JWT_SECRET=change-me-to-a-strong-random-secret

# Google OAuth
# Leave empty to disable the Google login button.
NEXT_PUBLIC_GOOGLE_CLIENT_ID=
